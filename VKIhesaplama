# GÖREV: Vücut kitle indeksi hesaplayan bir phthon kodu yapmak.
kilo = float(input("Kilonuzu kg cinsinden girin(örnek:65): "))
boy = float(input("Boyunuzu metre cinsinden girin(örnek:185): "))
boyhesap = boy/100
vki = kilo / (boyhesap ** 2)

if vki < 18.5:
    print("Zayıf")
elif vki >= 18.5 and vki < 24.9:
    print("Normal")
elif vki >= 25 and vki < 29.9:
    print("Fazla kilolu")
elif vki >= 30 and vki < 34.9:
    print("1. derece obez")
elif vki >= 35 and vki < 39.9:
    print("2. derece obez")
else:
    print("3. derece obez")
print("Vücut Kitle İndeksiniz:", vki)
